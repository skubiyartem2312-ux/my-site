<!DOCTYPE html><html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>May.obois.ss</title>  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">  <style>
    *{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth;}

    body{
      font-family:Inter,sans-serif;
      background:#050505;
      color:white;
      overflow-x:hidden;
    }

    body::before{
      content:'';
      position:fixed;
      inset:0;
      background:
        radial-gradient(circle at top left,rgba(120,0,255,.25),transparent 25%),
        radial-gradient(circle at bottom right,rgba(0,180,255,.18),transparent 25%);
      z-index:-1;
    }

    nav{
      position:fixed;
      top:0;
      width:100%;
      padding:16px 8%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      backdrop-filter:blur(20px);
      background:rgba(0,0,0,.55);
      border-bottom:1px solid rgba(255,255,255,.08);
      z-index:1000;
    }

    .logo{
      font-family:Orbitron;
      font-size:24px;
      color:#b366ff;
      text-shadow:0 0 15px #8f3dff;
    }

    nav button{
      background:none;
      border:none;
      color:white;
      margin:0 10px;
      cursor:pointer;
      font-size:15px;
      transition:.3s;
    }

    nav button:hover{color:#b366ff;}

    section{
      min-height:100vh;
      padding:120px 8%;
      display:none;
      animation:fade .5s ease;
    }

    section.active{display:block;}

    @keyframes fade{
      from{opacity:0;transform:translateY(20px);}
      to{opacity:1;transform:translateY(0);}
    }

    /* HOME */
    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:25px;
      margin-top:30px;
    }

    .card{
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.08);
      border-radius:20px;
      overflow:hidden;
      transition:.3s;
      backdrop-filter:blur(10px);
    }

    .card:hover{transform:translateY(-10px);}

    .card img{width:100%;height:220px;object-fit:cover;}

    .card-content{padding:20px;}

    .price{color:#66d9ff;font-weight:700;margin:10px 0;}

    .btn{
      padding:12px 22px;
      border-radius:10px;
      border:none;
      cursor:pointer;
      margin-top:10px;
      font-weight:600;
      transition:.3s;
    }

    .primary{background:linear-gradient(45deg,#7b2fff,#00bfff);color:white;}

    .secondary{background:transparent;border:1px solid #444;color:white;}

    .btn:hover{transform:scale(1.05);}

    /* FORMS */
    input,textarea{
      width:100%;
      margin-top:10px;
      padding:12px;
      border-radius:10px;
      border:none;
      background:#111;
      color:white;
    }

    .panel{
      max-width:500px;
    }

    /* MUSIC */
    .music{
      position:fixed;
      right:20px;
      bottom:20px;
      width:60px;
      height:60px;
      border-radius:50%;
      border:none;
      background:linear-gradient(45deg,#7b2fff,#00bfff);
      color:white;
      cursor:pointer;
    }
  </style></head>
<body><nav>
  <div class="logo">May.obois.ss</div>
  <div>
    <button onclick="show('home')">Главная</button>
    <button onclick="show('admin')">Админка</button>
    <button onclick="show('login')">Вход</button>
  </div>
</nav><!-- HOME (БРЕЛКИ) --><section id="home" class="active">
  <h2>Каталог брелков</h2>
  <div class="grid" id="products"></div>
</section><!-- ADMIN --><section id="admin">
  <h2>Админ панель</h2>
  <div class="panel">
    <input id="name" placeholder="Название">
    <input id="price" placeholder="Цена">
    <input id="img" placeholder="Фото URL">
    <button class="btn primary" onclick="addProduct()">Добавить товар</button>
  </div>
</section><!-- LOGIN --><section id="login">
  <h2>Вход / Регистрация</h2>
  <input placeholder="Email">
  <input type="password" placeholder="Пароль">
  <button class="btn primary">Войти</button>
</section><button class="music" onclick="toggleMusic()">♫</button> <audio id="music" loop> <source src="music.mp3"> </audio>

<script>
let products=[
  {name:"Cyber Keychain",price:25,img:"https://images.unsplash.com/photo-1515879218367-8466d910aaa4"},
  {name:"Luxury Metal",price:40,img:"https://images.unsplash.com/photo-1523275335684-37898b6baf30"},
  {name:"Dark Neon",price:30,img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff"}
];

function render(){
  document.getElementById("products").innerHTML=products.map(p=>`
    <div class='card'>
      <img src='${p.img}'>
      <div class='card-content'>
        <h3>${p.name}</h3>
        <div class='price'>€${p.price}</div>
        <button class='btn primary'>Купить</button>
      </div>
    </div>
  `).join("");
}

function addProduct(){
  products.push({
    name:document.getElementById("name").value,
    price:document.getElementById("price").value,
    img:document.getElementById("img").value
  });
  render();
  show('home');
}

function show(id){
  document.querySelectorAll('section').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function toggleMusic(){
  let m=document.getElementById('music');
  m.paused ? m.play() : m.pause();
}

// fix music autoplay restriction
window.addEventListener('click',()=>{
  document.getElementById('music').play().catch(()=>{});
},{once:true});

render();
</script></body>
</html>
